{
  "name": "@evergonlabs/poseidon2-evm",
  "version": "0.1.1-eip8182",
  "description": "EIP-8182-conformant Poseidon2-BN254 sponge hasher for the EVM, with a STATICCALL view interface (hash + domain-separated hashN).",
  "repository": {
    "type": "git",
    "url": "https://github.com/evergonlabs/poseidon2-evm"
  },
  "scripts": {
    "test": "forge test",
    "fmt": "prettier --write '**/*.{ts,js,json,md}' && forge fmt",
    "generate:yul": "npx tsx generate-yul.ts && forge fmt",
    "generate:huff": "npx tsx generate-huff.ts",
    "generate:gas-report": "./gas-report.sh",
    "verify:constants": "npx tsx scripts/verify-constants.ts",
    "build:artifacts": "forge build && npx tsx scripts/build-artifacts.ts"
  },
  "keywords": [
    "solidity",
    "evm",
    "poseidon2",
    "hash",
    "hasher",
    "sponge",
    "eip-8182",
    "bn254",
    "merkle-tree",
    "domain-separation",
    "foundry",
    "zk"
  ],
  "author": "Evergon Labs",
  "contributors": [
    "Soham Zemse (https://github.com/zemse)"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "src/eip8182",
    "src/bn254/yul/LibPoseidon2Yul.sol",
    "artifacts",
    "assets/eip-8182/poseidon2_bn254_t4_rf8_rp56.json",
    "assets/eip-8182/poseidon2_vectors.json"
  ],
  "devDependencies": {
    "prettier": "^3.8.1",
    "tsx": "^4.22.3"
  }
}
