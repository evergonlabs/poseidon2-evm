# Compiler files
cache/
out/

# Deploy artifacts — generated by `npm run build:artifacts` at publish time,
# not committed (a committed + CI-gated artifact is the production-time upgrade).
artifacts/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Local secrets / auth — never commit (npm auth token, dotenv)
.npmrc
.env

# Dependencies
node_modules/

archive

# Local Claude config
.claude/
CLAUDE.local.md

# Foundry lockfile (newer foundry auto-generates this; upstream zemse/poseidon2-evm
# doesn't commit it — gitignoring matches the upstream posture).
foundry.lock
